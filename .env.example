# Firebase Web App yapılandırması
# Firebase Console > Proje ayarları > Genel > "Uygulamalarınız" (Web app </>) altından kopyalayın.
# EXPO_PUBLIC_ ön eki zorunlu: Expo bu değişkenleri istemci paketine gömer.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# AI Proxy (Cloudflare Worker) — TÜM AI özellikleri buradan geçer.
#
# AI anahtarları (Gemini, OpenRouter) Worker'da SUNUCUDA tutulur, istemciye GÖMÜLMEZ.
# Kurulum (kart gerekmez, ücretsiz):
#   1) cloudflare-worker/ klasörüne gir
#   2) npx wrangler login
#   3) npx wrangler secret put GEMINI_API_KEY
#      npx wrangler secret put OPENROUTER_API_KEY
#   4) npx wrangler deploy
#   5) Çıkan adresi (https://frozfit-ai-proxy.<subdomain>.workers.dev) aşağıya yapıştır.
# Detaylar: cloudflare-worker/README.md
EXPO_PUBLIC_AI_PROXY_URL=

# Pixabay (Egzersizler sekmesinde TELİFSİZ videolar için) — https://pixabay.com/api/docs/
# Ücretsiz hesap aç, API anahtarını buraya yapıştır. Boşsa egzersizler fotoğraf
# gösterimine düşer (uygulama yine çalışır). Pixabay lisansı: ticari serbest, atıf gerekmez.
EXPO_PUBLIC_PIXABAY_KEY=

# Supabase (Toplulukta tarif fotoğrafı yüklemek için — ücretsiz, kart gerekmez)
# supabase.com → proje → Storage'da "recipe-images" adında PUBLIC bucket oluştur.
# Project Settings → API → URL ve anon public key'i buraya koy. Boşsa foto yükleme kapalıdır.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat (Premium aboneliği / In-App Purchase için) — https://app.revenuecat.com
# 1) RevenueCat'te iOS app oluştur, entitlement adını "pro" yap, bir offering ekle.
# 2) App Store Connect'te abonelik ürününü tanımlayıp RevenueCat'e bağla.
# 3) RevenueCat → API Keys → "Apple App Store" public key'i buraya yapıştır.
# Boşsa premium satın alma kapalıdır (uygulama yine çalışır, krediyle).
# NOT: Native modül → yalnızca EAS build'de çalışır, Expo Go'da değil.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
